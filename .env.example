BOT_TOKEN=1234567890:AAH_твой_токен_от_BotFather
# Самый быстрый бесплатный — Groq (0% CPU, ~2с на 60с). Бесплатно https://console.groq.com/keys -> gsk_...
GROQ_API_KEY=gsk_...
GROQ_MODEL=whisper-large-v3-turbo
# Альтернатива OpenAI (платно): sk-proj-...
OPENAI_API_KEY=
# Режим: auto = groq > openai > local | groq | api | local
STT_MODE=auto
# Локальный фолбэк если Groq упадёт: tiny=быстро, base=баланс, small=макс качество (рекоменд)
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_BEAM_SIZE=5
WHISPER_CPU_THREADS=8
WHISPER_VAD_MIN_SILENCE_MS=500
# Глобальный язык по умолчанию (перекрывается per-user /lang)
# WHISPER_LANGUAGE=ru  # форсить язык (ru/en/uk) — чуть точнее если знаешь
# WHISPER_INITIAL_PROMPT="Разговор на русском с матом и сленгом"
# Groq Chat для интонации /ton (тот же GROQ_API_KEY)
GROQ_CHAT_MODEL=openai/gpt-oss-20b
# Резервные LLM — фолбэк при 429/5xx/сети: Groq -> Cerebras -> Mistral -> OpenAI
# MISTRAL_API_KEY / MISTRAL_KEY
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
# CEREBRAS_API_KEY / CEREBRAS_KEY
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama3.1-8b
# Файл per-user настроек (язык + тон)
USER_PREFS_PATH=user_prefs.json
# Автопроверка каждого ГС как /check (false=только по команде)
AUTO_PROOF=false
# Антиспам
RATE_LIMIT_PER_MIN=5
# Админ — admin, через запятую если несколько (узнать ID: @userinfobot)
# ADMIN_IDS=123456789,987654321
ADMIN_IDS=
# База аналитики — приватно, не коммитить
USAGE_DB_PATH=usage.db
# Донаты (плейсхолдеры, реальные значения только в .env, не коммитить)
DONATE_CARD=0000000000000000
DONATE_URL=https://send.monobank.ua/jar/XXXX
DONATE_EXCLUDED_IDS=
SUPPORT_MILESTONES=5,7,9,11,13,15,17,19,21

# Бот-сосед для перекрёстной навигации (кнопка «перейти» в /start /about)
SIBLING_BOT_USERNAME=SayItBetterBot
SIBLING_BOT_LABEL=TextFixerBot — исправление текста
